# Linters


def cmd_sqlfluff(dialect, out):
    root = Path.cwd()
    # The code, not its tests (pgTAP's SELECT * FROM finish() is no ambiguity worth a finding).
    tests = set(discover(root, "mssql" if dialect == "tsql" else "postgres").tests)
    files = [str(f) for f in walk(root) if f.suffix.lower() in SQL_EXT and not is_test_path(f) and f not in tests
             and not vendored_tsqlt(f.name, read(root, f)[:20000])
             and not SQLCMD_RE.search(read(root, f)[:20000])][:400]
    if not files:
        write_json(out, [])
        return 0
    cfg = any((root / c).is_file() and "sqlfluff" in read(root, c) for c in (".sqlfluff", "setup.cfg", "tox.ini", "pyproject.toml"))
    cmd = ["sqlfluff", "lint", "--format", "json", "--nofail", "--disable-progress-bar", "--processes", "1", "--ignore", "parsing,templating"]
    if not cfg:
        # Without the repository's own configuration: its dialect, and no layout or capitalisation style rules.
        # tSQLt's test procedures are named [test ...] by convention (RF05).
        cmd += ["--dialect", dialect, "--exclude-rules", "layout,capitalisation" + (",RF05" if dialect == "tsql" else "")]
    r = subprocess.run(cmd + files, capture_output=True, text=True, timeout=1500)
    text = r.stdout.strip() or "[]"
    try:
        data = json.loads(text)
    except ValueError:
        start = text.find("[")
        data = json.loads(text[start:]) if start >= 0 else []
    keep = ("start_line_no", "start_line_pos", "line_no", "line_pos", "code", "description", "name", "warning")
    data = [{"filepath": f.get("filepath", ""), "violations": [{k: v[k] for k in keep if k in v} for v in f.get("violations", [])]}
            for f in data if isinstance(f, dict)]
    write_json(out, data)
    if r.stderr.strip():
        sys.stderr.write(r.stderr[-2000:])
    return 0


def cmd_squawk(out):
    root = Path.cwd()
    plan = discover(root, "postgres")
    # squawk lints migrations (the statements that change a live database); dbmate files carry their down section too.
    files = [str(rel) for rel, _ in plan.up] if plan.tool not in ("none", "schema files") else []
    if not files:
        write_json(out, [])
        return 0
    cmd = ["squawk", "--reporter", "json"]
    if not (root / ".squawk.toml").is_file():
        # Without the repository's own configuration: no rule that only asks for session timeouts in every migration.
        cmd += ["--exclude", "require-statement-timeout,require-lock-timeout"]
    r = subprocess.run(cmd + files[:500], capture_output=True, text=True, timeout=600)
    text = r.stdout.strip() or "[]"
    try:
        data = json.loads(text)
    except ValueError:
        data = []
        warn("squawk: " + (r.stderr or text)[-500:])
    write_json(out, data)
    return 0


def report_findings(path):
    """--fail (the CI pipelines): prints the findings of a JSON report and returns 1 when there are any."""
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    lines = []
    if isinstance(data, dict):  # migrate
        lines = [f"{f['file']}:{f['line']}: {f['rule']}: {f['message']}" for f in data.get("findings", [])]
        lines += ["note: " + n for n in data.get("notes", [])]
        bad = bool(data.get("findings"))
    elif data and "violations" in data[0]:  # sqlfluff
        lines = [f"{f['filepath']}:{v.get('start_line_no', v.get('line_no', 0))}: {v.get('code')}: {v.get('description')}" for f in data for v in f["violations"]]
        bad = bool(lines)
    else:  # squawk
        lines = [f"{v.get('file')}:{v.get('line', 0) + 1}: {v.get('rule_name')}: {v.get('message')}" for v in data]
        bad = bool(lines)
    print("\n".join(lines) or "no findings")
    return 1 if bad else 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 2
    cmd = argv[1]
    if cmd == "test" and len(argv) >= 4:
        level, flt = "unit", ""
        rest = argv[4:]
        while rest:
            a = rest.pop(0)
            if a == "--level" and rest:
                level = rest.pop(0)
            elif a == "--filter" and rest:
                flt = rest.pop(0)
        return cmd_test(argv[2], argv[3], level, flt)
    fail = "--fail" in argv
    argv = [a for a in argv if a != "--fail"]
    if cmd == "migrate" and len(argv) == 4:
        return cmd_migrate(argv[2], argv[3]) or (fail and report_findings(argv[3]))
    if cmd == "sqlfluff" and len(argv) == 4:
        return cmd_sqlfluff(argv[2], argv[3]) or (fail and report_findings(argv[3]))
    if cmd == "squawk" and len(argv) == 3:
        return cmd_squawk(argv[2]) or (fail and report_findings(argv[2]))
    if cmd == "plan":
        engine = argv[2] if len(argv) > 2 else "postgres"
        print(json.dumps(discover(Path.cwd(), engine).as_json(), indent=1))
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
