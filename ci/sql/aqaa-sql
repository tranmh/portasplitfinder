# Migration check


def cmd_migrate(engine, out):
    root = Path.cwd()
    plan = discover(root, engine)
    report = {"tool": plan.tool, "engine": engine, "migrations": len(plan.up), "down": "none", "findings": [], "notes": list(plan.notes)}
    if plan.tool == "none":
        report["notes"].append("no migrations and no schema files found")
        write_json(out, report)
        return 0
    if plan.tool == "schema files":
        report["notes"].append("no migration tool (Flyway, golang-migrate, dbmate, sqitch, Liquibase SQL or numbered files in a "
                               "migrations folder): the schema files are applied in dependency order instead")
    try:
        db = Postgres() if engine == "postgres" else MSSQL()
    except SystemExit as e:
        report["notes"].append(str(e))
        write_json(out, report)
        return 0
    db.create()
    try:
        results = []
        if apply_up(db, root, plan, results) and plan.down:
            report["down"] = "ok"
            for rel, text in plan.down:
                ok, line, err = db.apply(root, rel, text)
                if not ok:
                    results.append((str(rel), line, err, "down"))
                    report["down"] = "failed"
                    break
            if report["down"] == "ok":
                again = []
                apply_up(db, root, plan, again)
                results += [(r[0], r[1], r[2], "reapply") for r in again]
        for rel, line, err, phase in results:
            if plan.retry:
                report["findings"].append({"file": rel, "line": line, "rule": "schema-file-failed",
                                           "message": f"the schema file does not apply on a fresh database (after every other file that could): {err}"})
                continue
            rule = {"up": "migration-failed", "down": "down-migration-failed", "reapply": "migration-not-repeatable"}[phase]
            what = {"up": "does not apply on a fresh database (after the migrations before it)",
                    "down": "does not revert", "reapply": "fails when applied again after all down migrations"}[phase]
            report["findings"].append({"file": rel, "line": line, "rule": rule, "message": f"{plan.tool} migration {what}: {err}"})
    finally:
        db.drop()
    write_json(out, report)
    print(f"aqaa-sql: {plan.tool}: {len(plan.up)} migrations, down {report['down']}, {len(report['findings'])} findings")
    return 0


def write_json(path, obj):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text(json.dumps(obj, indent=1) + "\n", encoding="utf-8")


