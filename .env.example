# ---- Database ----
POSTGRES_USER=portasplit
POSTGRES_PASSWORD=portasplit
POSTGRES_DB=portasplit
# DATABASE_URL is used by the Go services. Inside docker compose the host is "db".
DATABASE_URL=postgres://portasplit:portasplit@db:5432/portasplit?sslmode=disable

# ---- API ----
API_PORT=8080
# Public base URL used to build confirm/unsubscribe links in emails.
PUBLIC_BASE_URL=http://localhost:8080

# ---- Web (frontend) ----
WEB_PORT=3000
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---- Poller ----
# How often the poller checks sources (Go duration string, e.g. 5m, 1h).
# OBI does ~357 requests/poll (one per German market), so keep this gentle.
POLL_INTERVAL=1h
POLLER_HEALTH_PORT=8090

# ---- Email (SMTP) ----
# In dev these point at Mailhog (smtp on 1025, web UI on 8025).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PortaSplitFinder <noreply@portasplitfinder.local>
# Set to "true" to require TLS (real SMTP); Mailhog uses plain.
SMTP_TLS=false

# ---- Sources ----
# Comma-separated source keys to enable. "mock" provides deterministic seed data.
# "obi" is a REAL per-market store adapter: it fetches all German OBI markets
# and their reserve & collect stock (true map pins). Enable it with SOURCES=mock,obi.
# Note OBI is bot-protected, so from some networks it may be blocked (the source is
# then marked errored and the app keeps working on the other sources).
# ebay,amazon,guenstiger,idealo are still stubs. OBI_LIVE=1 enables the opt-in live OBI test.
SOURCES=mock,obi
