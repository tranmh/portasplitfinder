# ---- Database ----
POSTGRES_USER=portasplit
POSTGRES_PASSWORD=portasplit
POSTGRES_DB=portasplit
# DATABASE_URL is used by the Go services. Inside docker compose the host is "db".
DATABASE_URL=postgres://portasplit:portasplit@db:5432/portasplit?sslmode=disable

# ---- API ----
API_PORT=8080
# Public base URL used to build confirm/unsubscribe links in emails.
PUBLIC_BASE_URL=http://localhost:8080

# ---- Web (frontend) ----
WEB_PORT=3000
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---- Poller ----
# How often the poller checks sources (Go duration string, e.g. 5m, 1h).
# OBI does ~357 requests/poll (one per German market), so keep this gentle.
POLL_INTERVAL=1h
POLLER_HEALTH_PORT=8090

# ---- Email (SMTP) ----
# In dev these point at Mailhog (smtp on 1025, web UI on 8025).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PortaSplitFinder <noreply@portasplitfinder.local>
# Set to "true" to require TLS (real SMTP); Mailhog uses plain.
SMTP_TLS=false

# ---- Sources ----
# Comma-separated source keys to enable. "mock" provides deterministic seed data.
# "obi" is a REAL per-market store adapter: it fetches all German OBI markets
# and their reserve & collect stock (true map pins). Enable it with SOURCES=mock,obi.
# Note OBI is bot-protected, so from some networks it may be blocked (the source is
# then marked errored and the app keeps working on the other sources).
# "bauhaus" is a REAL per-market store adapter too: it fetches German BAUHAUS
# Fachcentren within 50 km of PLZ 73035 and their reserve & collect stock (true
# map pins). BAUHAUS is behind Cloudflare Bot Management and returns 403 to plain
# HTTP clients; testing showed neither browser-TLS impersonation nor a headless
# browser get past it from a single IP, so live data requires a web-unblocker
# (see UNBLOCKER_URL below). Without one it degrades gracefully (ErrBlocked ->
# source errored, the app keeps working). Enable it with SOURCES=mock,obi,bauhaus.
# ebay,amazon,guenstiger,idealo are still stubs. OBI_LIVE=1 / BAUHAUS_LIVE=1 enable the
# opt-in live OBI / BAUHAUS tests.
SOURCES=mock,obi

# ---- Web unblocker (optional) ----
# Real adapters (obi, bauhaus) route requests through this web-unblocker API when
# set, to get past bot protection (Cloudflare). It is a URL TEMPLATE containing
# the literal placeholder {{url}} — the target URL is URL-encoded and substituted
# in. Leave empty to fetch directly (adapters then degrade gracefully when blocked).
# Examples (drop in your own API key):
#   ScrapingBee: https://app.scrapingbee.com/api/v1/?api_key=KEY&premium_proxy=true&country_code=de&url={{url}}
#   ZenRows:     https://api.zenrows.com/v1/?apikey=KEY&js_render=true&antibot=true&premium_proxy=true&proxy_country=de&url={{url}}
UNBLOCKER_URL=
